# Production env for docker-compose.deploy.yml. Copy to `.env.prod` on the server
# (and locally when you run migrate/seed against the prod DB). NEVER commit the
# filled-in copy — `.env*` is gitignored.

# The registry image to run. Build + push this from your local machine.
# Example: ghcr.io/<owner>/grseed-app:2026-06-04
IMAGE=ghcr.io/<owner>/grseed-app:latest

# Host port the container's :3000 is published on. Your own reverse proxy
# (terminating TLS for https://www.ahgrzy.com) forwards to this port.
APP_PORT=3000

# External Postgres (panel-managed). Use the SSL form your panel requires, e.g.
# postgres://user:pass@db-host:5432/grseed?sslmode=require
DATABASE_URL=postgres://user:password@db-host:5432/grseed

# Signs Payload auth/session tokens. Generate once and keep it STABLE forever
# (changing it invalidates all existing admin sessions). Generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Media storage (OPTIONAL) ---------------------------------------------
# Leave S3_BUCKET EMPTY to disable S3 entirely: the app falls back to local-disk
# uploads and starts without error. Fine if you don't use the media/upload
# feature. If you DO upload files without S3, mount a volume in the deploy
# compose (see docker-compose.deploy.yml) or they vanish on the next redeploy.
#
# To use external S3-compatible storage, fill all five S3_* values below.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 'true' for MinIO / most panels; 'false' for AWS S3-style virtual-hosted URLs.
S3_FORCE_PATH_STYLE=true
