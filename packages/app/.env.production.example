# Production deploy/migrate credentials. Copy to `.env.production`
# (gitignored) or set the same names as GitHub Actions secrets.
# CI on master runs `task release` only and needs the three values below.
# D1/R2 are Worker bindings in wrangler.jsonc, not env vars.

CLOUDFLARE_ACCOUNT_ID=
# Optional locally if you already ran `wrangler login`. Required in CI.
CLOUDFLARE_API_TOKEN=

# Signs Payload auth/session tokens. Must match the Worker secret
# written by `task secret:put`. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Used by `task admin:bootstrap` and `task seed`.
PAYLOAD_SEED_ADMIN_EMAIL=
PAYLOAD_SEED_ADMIN_PASSWORD=

# Used by `task admin:bootstrap` and `task richtext:migrate`.
CANONICAL_URL=https://grseed.com
