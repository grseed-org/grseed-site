# Local-only Payload/Next values. D1/R2 are Worker bindings in wrangler.jsonc.
# Production CLI credentials live in `.env.production` or CI env vars, not here.
# Local CMS storage uses Wrangler's D1/R2 simulation (`task local:setup`).

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional first-admin values for ad hoc local scripts.
PAYLOAD_SEED_ADMIN_EMAIL=admin@grseed.local
PAYLOAD_SEED_ADMIN_PASSWORD=change-me
