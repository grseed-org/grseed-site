# Local-only Payload/Next values. Production secrets live in Cloudflare Worker
# secrets and are written through Wrangler; D1/R2 are Worker bindings configured
# in wrangler.jsonc. Local CMS storage uses Wrangler's D1/R2 simulation
# (`task local:setup`, also run automatically by `task dev`).

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional first-admin values for ad hoc local scripts.
PAYLOAD_SEED_ADMIN_EMAIL=admin@grseed.local
PAYLOAD_SEED_ADMIN_PASSWORD=change-me
